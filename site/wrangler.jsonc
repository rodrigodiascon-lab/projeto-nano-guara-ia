{
  "name": "nanoguara-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  // binding ASSETS: o Worker precisa buscar o 404.html por conta própria, já que
  // ele atende toda URL que não casa com um asset (ver paginaNaoEncontrada).
  "assets": { "directory": "./public", "not_found_handling": "404-page", "binding": "ASSETS" },
  // expurgo diário dos leads vencidos, 05:00 UTC (02:00 em Manaus, UTC-4)
  "triggers": { "crons": ["0 5 * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "nanoguara-leads", "database_id": "38a098a0-1f04-482c-ba77-3a9455c6e5e3", "migrations_dir": "migrations" }
  ],
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "CHAT_RL", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LEAD_RL", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "send_email": [
    { "name": "NOTIFY", "destination_address": "rodrigodias.consultor@gmail.com" }
  ],
  "vars": {
    "WHATSAPP_NUMBER": "5592981486875",
    "AI_GATEWAY_ID": "nanoguara",
    "TURNSTILE_HOSTNAME": "nanoguara.ia.br",
    "LEAD_FROM": "contato@nanoguara.ia.br",
    "LEAD_TO": "rodrigodias.consultor@gmail.com"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
