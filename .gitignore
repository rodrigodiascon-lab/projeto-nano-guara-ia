.claude/
.claude-flow/
.DS_Store
.worktrees/

# Mídia gerada dos posts de marketing. Fica de fora porque binário grande não
# sai mais do histórico do git depois de entrar, e este material é regenerável:
# o prompts.md e o index.html de cada post continuam versionados ao lado.
docs/marketing/brand/posts/**/*.png
docs/marketing/brand/posts/**/*.jpg
docs/marketing/brand/posts/**/*.mp4
docs/marketing/brand/posts/**/*.woff2
# .svg e .pdf pela mesma razão, e faltavam: o avatar-chat.svg é cópia do que já
# está em site/public/brand, e o copys-nanoguara-instagram-v2.pdf é saída do
# build_pdf.py rodando sobre o copys.md — os dois versionados ao lado dele.
docs/marketing/brand/posts/**/*.svg
docs/marketing/brand/posts/**/*.pdf
docs/marketing/brand/posts/**/*.zip

# Estado local de ferramenta, não código do projeto.
.superpowers/
.swarm/
agentdb.rvf
agentdb.rvf.lock
ruvector.db

# Scratch de QA (renders de página, contact sheets) — regenerável, não versiona.
tmp/

# Saída do Playwright (traces, screenshots, relatório). Regenerável rodando
# `npm run test:layout` em site/.
site/test-results/
site/playwright-report/

# Token do Meta Ads (pacote trafego-pago)
.env

# Mídia pesada de anúncios, vídeos e mascote (decisão do dono em 2026-10-01).
# Mesma razão dos posts acima: binário não sai do histórico e é regenerável.
# As versões que o site usa ficam em site/public e continuam versionadas.
videos/**/*.mp4
videos/**/*.wav
videos/**/.media/
docs/marketing/meta-ads/**/*.png
docs/marketing/meta-ads/**/*.jpg
docs/marketing/meta-ads/**/*.mp4
docs/marketing/brand/guara-bot/**/*.png
assets/referencias/**/*.png
assets/referencias/**/*.jpg
output/

# Caches e capturas do HyperFrames: regeneráveis (preview, snapshot, waveform).
videos/**/.thumbnails/
videos/**/.waveform-cache/
videos/**/.hyperframes/
videos/**/snapshots/
